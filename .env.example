# Required on Vercel; optional for local playback. Stream directly from the host.
# Upload the exact prepared files; another edit can misalign captions.
# DEMO_VIDEO_URL=https://your-rights-clear-external-host.example/video.mp4
# SINTEL_VIDEO_URL=https://your-rights-clear-external-host.example/sintel.mp4
# TEARS_OF_STEEL_VIDEO_URL=https://your-rights-clear-external-host.example/tears-of-steel.mp4

# No API key is required for Phase 1 playback.
# Offline NVIDIA probes read this local variable only. Do not deploy this key.
# NVIDIA_KEY is also supported. Set one; process environment takes precedence.
# The failed audio model remains gated; offline text variants are a separate path.
NVIDIA_API_KEY=
NEXT_TELEMETRY_DISABLED=1
VERCEL_TOKEN=
