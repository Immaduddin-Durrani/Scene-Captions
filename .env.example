# Optional only for later hosted playback. Never proxy video through Render.
# Local demo works without this variable after npm run setup:demo.
# DEMO_VIDEO_URL=https://your-rights-clear-external-host.example/video.mp4

# No API key is required for Phase 1 playback.
# Offline NVIDIA probes read this local variable only. Do not deploy this key.
# The current audio model failed capability checks; generation is blocked.
NVIDIA_API_KEY=
NEXT_TELEMETRY_DISABLED=1
