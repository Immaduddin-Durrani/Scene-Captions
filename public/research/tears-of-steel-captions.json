  "dialogue": [
    {
      "cue_id": "tears-of-steel-dialogue-1",
      "start_s": 23,
      "end_s": 24.5,
      "text": "You're a jerk, Thom."
    },
    {
      "cue_id": "tears-of-steel-dialogue-2",
      "start_s": 25,
      "end_s": 27,
      "text": "Look Celia, we have to follow our passions;"
    },
    {
      "cue_id": "tears-of-steel-dialogue-3",
      "start_s": 27,
      "end_s": 30.5,
      "text": "...you have your robotics, and I\njust want to be awesome in space."
    },
    {
      "cue_id": "tears-of-steel-dialogue-4",
      "start_s": 30.8,
      "end_s": 34,
      "text": "Why don't you just admit that\nyou're freaked out by my robot hand?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-5",
      "start_s": 34.5,
      "end_s": 36,
      "text": "I'm not freaked out by- it's..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-6",
      "start_s": 37,
      "end_s": 38,
      "text": "...alright! Fine!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-7",
      "start_s": 38,
      "end_s": 41,
      "text": "I'm freaked out! I have nightmares\nthat I'm being chased..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-8",
      "start_s": 41,
      "end_s": 42,
      "text": "...by these giant robotic claws of death..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-9",
      "start_s": 42.2,
      "end_s": 45,
      "text": "\"Fourty years later\"\nWhatever, Thom. We're done."
    },
    {
      "cue_id": "tears-of-steel-dialogue-10",
      "start_s": 50,
      "end_s": 53.5,
      "text": "Robot's memory synced and locked!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-11",
      "start_s": 61,
      "end_s": 63,
      "text": "This is pretty freaky."
    },
    {
      "cue_id": "tears-of-steel-dialogue-12",
      "start_s": 117,
      "end_s": 119,
      "text": "Shouldn't you be down there?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-13",
      "start_s": 131,
      "end_s": 133,
      "text": "I heard you guys talking last night."
    },
    {
      "cue_id": "tears-of-steel-dialogue-14",
      "start_s": 136,
      "end_s": 138,
      "text": "It's not my fault, you know."
    },
    {
      "cue_id": "tears-of-steel-dialogue-15",
      "start_s": 191,
      "end_s": 192,
      "text": "Are you ready?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-16",
      "start_s": 193,
      "end_s": 195,
      "text": "Of course you're ready, you're a rockstar."
    },
    {
      "cue_id": "tears-of-steel-dialogue-17",
      "start_s": 197,
      "end_s": 198,
      "text": "How's it looking, Barley?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-18",
      "start_s": 199,
      "end_s": 201,
      "text": "We should have about ten minutes..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-19",
      "start_s": 201.5,
      "end_s": 203,
      "text": "Well that's perfect."
    },
    {
      "cue_id": "tears-of-steel-dialogue-20",
      "start_s": 203.5,
      "end_s": 206.5,
      "text": "We're on in one! All systems go!\nYeah you, go!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-21",
      "start_s": 208,
      "end_s": 212,
      "text": "Go! Move your asses! Go go go!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-22",
      "start_s": 213,
      "end_s": 217,
      "text": "I love it! Come on, go!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-23",
      "start_s": 223,
      "end_s": 224,
      "text": "That's nice."
    },
    {
      "cue_id": "tears-of-steel-dialogue-24",
      "start_s": 224.5,
      "end_s": 225.7,
      "text": "Nothing to worry about."
    },
    {
      "cue_id": "tears-of-steel-dialogue-25",
      "start_s": 226,
      "end_s": 227,
      "text": "Thom."
    },
    {
      "cue_id": "tears-of-steel-dialogue-26",
      "start_s": 231,
      "end_s": 233,
      "text": "There she is."
    },
    {
      "cue_id": "tears-of-steel-dialogue-27",
      "start_s": 233.5,
      "end_s": 234.5,
      "text": "Now."
    },
    {
      "cue_id": "tears-of-steel-dialogue-28",
      "start_s": 235,
      "end_s": 236,
      "text": "You love her."
    },
    {
      "cue_id": "tears-of-steel-dialogue-29",
      "start_s": 237,
      "end_s": 238.5,
      "text": "She is your passion!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-30",
      "start_s": 240,
      "end_s": 241,
      "text": "Be tender to her."
    },
    {
      "cue_id": "tears-of-steel-dialogue-31",
      "start_s": 241.5,
      "end_s": 244.5,
      "text": "Be honest! Eh- be tender."
    },
    {
      "cue_id": "tears-of-steel-dialogue-32",
      "start_s": 245,
      "end_s": 248,
      "text": "Remind her what love is."
    },
    {
      "cue_id": "tears-of-steel-dialogue-33",
      "start_s": 292,
      "end_s": 295,
      "text": "...and, action!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-34",
      "start_s": 296.5,
      "end_s": 298,
      "text": "Memory overwrite in progress!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-35",
      "start_s": 299,
      "end_s": 301,
      "text": "You're a jerk, Thom!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-36",
      "start_s": 302.5,
      "end_s": 305,
      "text": "Ohp- Sorry! Sorry."
    },
    {
      "cue_id": "tears-of-steel-dialogue-37",
      "start_s": 316,
      "end_s": 317,
      "text": "Look Celia."
    },
    {
      "cue_id": "tears-of-steel-dialogue-38",
      "start_s": 318,
      "end_s": 320,
      "text": "We have to follow our passions."
    },
    {
      "cue_id": "tears-of-steel-dialogue-39",
      "start_s": 321,
      "end_s": 323,
      "text": "You have your robotics..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-40",
      "start_s": 325,
      "end_s": 328,
      "text": "...and I just want to be awesome in space."
    },
    {
      "cue_id": "tears-of-steel-dialogue-41",
      "start_s": 339,
      "end_s": 341,
      "text": "Okay, they're coming. Two minutes left!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-42",
      "start_s": 343,
      "end_s": 344,
      "text": "Speed it up, Thom!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-43",
      "start_s": 345,
      "end_s": 346,
      "text": "Vivacissimo!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-44",
      "start_s": 347,
      "end_s": 350,
      "text": "Why don't you just admit that you're\nfreaked out by my robot hand?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-45",
      "start_s": 356,
      "end_s": 359,
      "text": "Listen Celia, I was young..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-46",
      "start_s": 359.5,
      "end_s": 361,
      "text": "...and a dick."
    },
    {
      "cue_id": "tears-of-steel-dialogue-47",
      "start_s": 361,
      "end_s": 363,
      "text": "But that's no reason to\ndestroy the world."
    },
    {
      "cue_id": "tears-of-steel-dialogue-48",
      "start_s": 365,
      "end_s": 366,
      "text": "Why does he do this?"
    },
    {
      "cue_id": "tears-of-steel-dialogue-49",
      "start_s": 366.5,
      "end_s": 368.5,
      "text": "We already tried that one!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-50",
      "start_s": 371.5,
      "end_s": 372.5,
      "text": "Abort!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-51",
      "start_s": 373,
      "end_s": 374,
      "text": "Cut!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-52",
      "start_s": 374,
      "end_s": 375,
      "text": "Whoaaa!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-53",
      "start_s": 379,
      "end_s": 380,
      "text": "Whoaaa!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-54",
      "start_s": 381,
      "end_s": 383,
      "text": "Nooooo!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-55",
      "start_s": 383,
      "end_s": 385,
      "text": "You broke my heart."
    },
    {
      "cue_id": "tears-of-steel-dialogue-56",
      "start_s": 386,
      "end_s": 387,
      "text": "I know."
    },
    {
      "cue_id": "tears-of-steel-dialogue-57",
      "start_s": 387,
      "end_s": 389,
      "text": "You forgot me on earth."
    },
    {
      "cue_id": "tears-of-steel-dialogue-58",
      "start_s": 389,
      "end_s": 390,
      "text": "I know."
    },
    {
      "cue_id": "tears-of-steel-dialogue-59",
      "start_s": 390.5,
      "end_s": 393,
      "text": "I should just crush you."
    },
    {
      "cue_id": "tears-of-steel-dialogue-60",
      "start_s": 396,
      "end_s": 397,
      "text": "I'm-"
    },
    {
      "cue_id": "tears-of-steel-dialogue-61",
      "start_s": 407,
      "end_s": 408,
      "text": "I'm sorry."
    },
    {
      "cue_id": "tears-of-steel-dialogue-62",
      "start_s": 410,
      "end_s": 411,
      "text": "Good ad-lib."
    },
    {
      "cue_id": "tears-of-steel-dialogue-63",
      "start_s": 419,
      "end_s": 420.5,
      "text": "Not my fault!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-64",
      "start_s": 422,
      "end_s": 423,
      "text": "This time."
    },
    {
      "cue_id": "tears-of-steel-dialogue-65",
      "start_s": 428,
      "end_s": 429.5,
      "text": "Quiet on set!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-66",
      "start_s": 430,
      "end_s": 431,
      "text": "We're out of time!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-67",
      "start_s": 493,
      "end_s": 494,
      "text": "Come on!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-68",
      "start_s": 502,
      "end_s": 504,
      "text": "RAAAAAAAAH!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-69",
      "start_s": 504,
      "end_s": 505,
      "text": "Memory overwrite, 90%."
    },
    {
      "cue_id": "tears-of-steel-dialogue-70",
      "start_s": 506,
      "end_s": 508,
      "text": "Captain! We have to abort!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-71",
      "start_s": 518,
      "end_s": 520,
      "text": "The world's changed, Celia..."
    },
    {
      "cue_id": "tears-of-steel-dialogue-72",
      "start_s": 534,
      "end_s": 536,
      "text": "...maybe we can too."
    },
    {
      "cue_id": "tears-of-steel-dialogue-73",
      "start_s": 538,
      "end_s": 539,
      "text": "Memory overwrite complete!"
    },
    {
      "cue_id": "tears-of-steel-dialogue-74",
      "start_s": 559,
      "end_s": 560,
      "text": "You know."
    },
    {
      "cue_id": "tears-of-steel-dialogue-75",
      "start_s": 562,
      "end_s": 564,
      "text": "There's a lesson to be learned from this."
    },
    {
      "cue_id": "tears-of-steel-dialogue-76",
      "start_s": 566,
      "end_s": 567,
      "text": "Could'a gone worse."
    }
  ],
